      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[none:Order_Status:nk]' type='palette'>
            <map to='#4e79a7'>
              <bucket>&quot;Delivered&quot;</bucket>
            </map>
            <map to='#76b7b2'>
              <bucket>&quot;Shipped&quot;</bucket>
            </map>
            <map to='#e15759'>
              <bucket>&quot;Processing&quot;</bucket>
            </map>
            <map to='#f28e2b'>
              <bucket>&quot;Pending&quot;</bucket>
            </map>
          </encoding>
